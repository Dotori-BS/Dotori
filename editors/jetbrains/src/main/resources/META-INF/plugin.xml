<idea-plugin>
    <id>dev.dotori.jetbrains</id>
    <name>Dotori</name>
    <vendor url="https://github.com/Dotori-BS/Dotori">Dotori Contributors</vendor>
    <description><![CDATA[
        Language Server integration for the Dotori C++ build system.
        Syntax highlighting and LSP completion, diagnostics, navigation and formatting
        for .dotori files. Configure the executable under Settings | Languages &amp; Frameworks | Dotori.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.dotori.jetbrains.DotoriSettings"/>
        <fileType
                name="Dotori"
                implementationClass="dev.dotori.jetbrains.DotoriFileType"
                fieldName="INSTANCE"
                extensions="dotori"
                fileNames=".dotori"/>
        <applicationConfigurable parentId="language" id="dev.dotori.settings"
                displayName="Dotori" instance="dev.dotori.jetbrains.DotoriConfigurable"/>
        <lang.syntaxHighlighterFactory language="Dotori"
                implementationClass="dev.dotori.jetbrains.DotoriSyntaxHighlighterFactory"/>
        <platform.lsp.integrationProvider
                implementation="dev.dotori.jetbrains.DotoriLspIntegrationProvider"/>
        <formatOnSaveOptions.defaultsProvider
                implementation="dev.dotori.jetbrains.DotoriFormatOnSaveDefaultsProvider"/>
    </extensions>
</idea-plugin>
